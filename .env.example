# AI features use each signed-in user's own OpenRouter key (BYOK), saved in Settings.
# Default model offered to users (any OpenRouter model id).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Supabase (login, per-user data, BYOK). URL + publishable key are public by design (RLS protects data).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Dashboard > Project Settings > API Keys > Secret keys). Never expose to the browser.
SUPABASE_SECRET_KEY=
